@Override
public RegisteredClient findByClientId(String clientId) {

    String sql = "SELECT client_id FROM oauth_client_details";

    return jdbcTemplate.query(sql, rs -> {

        while (rs.next()) {

            String dbClientId = rs.getString("client_id");

            if (clientId.equals(dbClientId)) {

                System.out.println("Client ID loaded successfully: " + dbClientId);

                return RegisteredClient.withId(dbClientId)
                        .clientId(dbClientId)
                        .build();
            }
        }

        return null;
    });
}
