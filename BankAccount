public class MainActivity extends AppCompatActivity {

    Button showBottomSheetBtn;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_main);
        
        showBottomSheetBtn = findViewById(R.id.showBottomSheetBtn);
        
        showBottomSheetBtn.setOnClickListener(v -> showBottomSheetDialog());
    }

    private void showBottomSheetDialog() {
        BottomSheetDialog bottomSheetDialog = new BottomSheetDialog(this);
        View view = getLayoutInflater().inflate(R.layout.bottom_sheet_layout, null);
        
        RadioGroup radioGroup = view.findViewById(R.id.radioGroup);
        RadioButton radioCustom = view.findViewById(R.id.radioCustom);
        EditText editCustomUpi = view.findViewById(R.id.editCustomUpi);
        Button btnConfirm = view.findViewById(R.id.btnConfirm);

        radioGroup.setOnCheckedChangeListener((group, checkedId) -> {
            if (checkedId == R.id.radioCustom) {
                editCustomUpi.setVisibility(View.VISIBLE);
            } else {
                editCustomUpi.setVisibility(View.GONE);
            }
        });

        btnConfirm.setOnClickListener(v -> {
            int selectedId = radioGroup.getCheckedRadioButtonId();
            RadioButton selectedRadio = view.findViewById(selectedId);

            String selectedUpiId;
            if (selectedId == R.id.radioCustom) {
                selectedUpiId = editCustomUpi.getText().toString().trim() + "@sbi";
            } else {
                selectedUpiId = selectedRadio.getText().toString();
            }

            Toast.makeText(this, "Selected UPI ID: " + selectedUpiId, Toast.LENGTH_SHORT).show();
            bottomSheetDialog.dismiss();
        });

        bottomSheetDialog.setContentView(view);
        bottomSheetDialog.show();
    }
}
