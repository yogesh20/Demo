<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Create UPI ID"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingBottom="8dp"/>

    <RadioGroup
        android:id="@+id/radioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/radioDefault1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8424888689@sbi"/>

        <RadioButton
            android:id="@+id/radioDefault2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Siddheshkorgaonkar123@sbi"/>

        <RadioButton
            android:id="@+id/radioDefault3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Siddheshkorgaonkar@sbi"/>

        <RadioButton
            android:id="@+id/radioCustom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Custom UPI ID"/>

    </RadioGroup>

    <EditText
        android:id="@+id/editCustomUpi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter custom UPI ID"
        android:inputType="text"
        android:visibility="gone"
        android:padding="8dp"/>

    <Button
        android:id="@+id/btnConfirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Confirm UPI ID"
        android:layout_marginTop="16dp"/>
</LinearLayout>
