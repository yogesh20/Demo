public class AccountBottomSheet extends BottomSheetDialogFragment {

    private RecyclerView recyclerAccounts;
    private AccountAdapter adapter;
    private List<Account> accountList;

    @Nullable
    @Override
    public View onCreateView(@NonNull LayoutInflater inflater, @Nullable ViewGroup container,
                             @Nullable Bundle savedInstanceState) {
        View view = inflater.inflate(R.layout.fragment_account_bottom_sheet, container, false);
        recyclerAccounts = view.findViewById(R.id.recyclerAccounts);
        Button btnAddAccount = view.findViewById(R.id.btnAddAccount);

        initAccountList();
        adapter = new AccountAdapter(accountList);
        recyclerAccounts.setLayoutManager(new LinearLayoutManager(getContext()));
        recyclerAccounts.setAdapter(adapter);

        btnAddAccount.setOnClickListener(v -> dismiss());

        view.setFocusableInTouchMode(true);
        view.requestFocus();
        view.setOnKeyListener((v, keyCode, event) -> {
            if (keyCode == KeyEvent.KEYCODE_BACK) {
                dismiss();
                return true;
            }
            return false;
        });

        return view;
    }

    private void initAccountList() {
        accountList = new ArrayList<>();
        accountList.add(new Account("SBI (Primary account)", "1265", true, false));
        accountList.add(new Account("State Bank of India", "5674", false, true));
        accountList.add(new Account("State Bank of india", "6786", false, false));
    }
}
