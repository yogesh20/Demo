SELECT COLUMN_ID,
       COLUMN_NAME,
       DATA_TYPE,
       DATA_LENGTH,
       NULLABLE
FROM ALL_TAB_COLUMNS
WHERE OWNER = 'PSPRECON'
  AND TABLE_NAME = 'VTUTTRNREQPY'
ORDER BY COLUMN_ID;





SELECT a.CONSTRAINT_NAME,
       a.CONSTRAINT_TYPE,
       a.STATUS,
       c.COLUMN_NAME
FROM ALL_CONSTRAINTS a
LEFT JOIN ALL_CONS_COLUMNS c
  ON a.OWNER = c.OWNER
 AND a.CONSTRAINT_NAME = c.CONSTRAINT_NAME
WHERE a.OWNER = 'PSPRECON'
  AND a.TABLE_NAME = 'VTUTTRNREQPY';
