SELECT
    REQ.CUSTREFNO AS CUSTREFNUM,
    REQ.TXNID AS TRANSACTION_ID,
    PY.PYIDVERNAME AS PAYEE_BANK,
    PY.PYIFSCCODE AS PAYEE_BANK_CODE,
    PY.ACCNO_REDC AS PAYEE_ACCOUNT_NUMBER,
    REQ.TXNAMOUNT AS AMOUNT,
    TO_CHAR(
        REQ.TRNDATE,
        'YYYY-MM-DD HH24:MI:SS'
    ) AS TRANSACTION_DATETIME,
    REQ.PURPOSE AS PURPOSE_CODE,
    REQ.PAYTYPE AS TRANSACTION_TYPE,
    REQ.TRNREFNO AS TRN_REF_NUM,
    REQ.ORGTRNREFNO AS ORGTRNREFNUM,
    PY.PYFVADDR AS PAYER_VPA,
    REQ.PRACCNO AS PAYER_ACCNO
FROM VTUTTRNREQ REQ
INNER JOIN VTUTTRNREQPY PY
    ON REQ.TRNREFNO = PY.TRNREFNO
WHERE REQ.CUSTREFNO = :CUSTREFNUM
  AND REQ.PRACCNO = :PRACCNO1
  AND REQ.TXNAMOUNT = TO_NUMBER(:REQAMOUNT) * 100
  AND REQ.DRC RFLAG = 'D';