SELECT
    TO_CHAR(CRTDATE, 'DD-MM-YYYY') AS create_date,
    TO_CHAR(MNDAMOUNT / 100, '9999999990.00') AS amount,
    CUSTREFNO AS rrn,
    CURRSTATUSCODE AS status_code,
    CURRSTATUSDESC AS status_description,
    TO_CHAR(MDYDATE, 'DD-MM-YYYY') AS modify_date,
    PYFNAME AS ipo_name
FROM VTUMMANDATE
WHERE PRACCNO = '00000030002340645'
  AND CRTDATE BETWEEN
      TO_DATE('01-10-2026 00:00:00', 'DD-MM-RR HH24:MI:SS')
      AND TO_DATE('09-10-2026 23:59:59', 'DD-MM-RR HH24:MI:SS')
  AND DRCRFLAG = 'D'
  AND MNDINIT = 'RM'
  AND PYCODE = 6211
  AND MNDPATTERN = 'ONETIME';
