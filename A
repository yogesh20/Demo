SELECT
ICCW.UPIRRN AS UPI_RRN,
ICCW.TXNID AS TXN_ID,
ICCW.TXNAMOUNT AS Transaction_Amount,
ICCW.CRTDATE AS Transaction_Date,
ICCW.PRACCNO AS Payer_Account,
ICCW.PRIFSCCD AS Payer_IFSC,
ICCW.PRVADD AS Payer_VPA,
ICCW.PYFVADDR AS Payee_VPA,
ICCW.NFSRRN AS NFS_RRN,
ICCW.ATMID AS ATMID,
ICCW.CURRSTATUSDESC AS Transaction_Status,
ICCW.TXNTYPE AS Transaction_Type,
ICCW.TXNNOTE AS Transaction_Remarks,
ICCW.PRACCNAME AS Payer_Account_Name,
ICCW.PYIFSCCD AS Payee_IFSC,
ICCW.PYFNAME AS Payee_Name
FROM VTUTICCWNTNREQ ICCW
WHERE ICCW.PRACCNO = 'F93A13E3C659ACFB1C22C3F6E7F07481'
AND ICCW.CRTDATE >= TO_DATE('12-09-2025', 'DD-MM-YYYY')
AND ICCW.CRTDATE < TO_DATE('13-09-2025', 'DD-MM-YYYY')
AND ICCW.DRCREFLAG = 'D';