@Override
public RegisteredClient findByClientId(String clientId) {

    String sql = """
            SELECT client_id,
                   client_secret,
                   authorized_grant_types,
                   web_server_redirect_uri,
                   access_token_validity,
                   refresh_token_validity
            FROM oauth_client_details
            WHERE client_id = ?
            """;

    return jdbcTemplate.query(sql, new Object[] { clientId }, rs -> {

        if (!rs.next()) {
            return null;
        }

        String dbClientId = rs.getString("client_id");
        String clientSecret = rs.getString("client_secret");
        String grantTypes = rs.getString("authorized_grant_types");
        String redirectUri = rs.getString("web_server_redirect_uri");

        Integer accessTokenValidity =
                rs.getObject("access_token_validity", Integer.class);

        Integer refreshTokenValidity =
                rs.getObject("refresh_token_validity", Integer.class);

        RegisteredClient.Builder builder =
                RegisteredClient.withId(dbClientId)
                        .clientId(dbClientId)
                        .clientSecret("{noop}" + clientSecret)
                        .clientAuthenticationMethod(
                                ClientAuthenticationMethod.CLIENT_SECRET_BASIC);

        /*
         * Legacy OAuth grant types:
         *
         * authorization_code
         * refresh_token
         * password
         * implicit
         *
         * Spring Authorization Server directly supports:
         * authorization_code
         * refresh_token
         * client_credentials
         */

        if (grantTypes != null) {

            for (String grant : grantTypes.split(",")) {

                grant = grant.trim();

                if ("authorization_code".equalsIgnoreCase(grant)) {
                    builder.authorizationGrantType(
                            AuthorizationGrantType.AUTHORIZATION_CODE);
                }

                if ("refresh_token".equalsIgnoreCase(grant)) {
                    builder.authorizationGrantType(
                            AuthorizationGrantType.REFRESH_TOKEN);
                }

                if ("client_credentials".equalsIgnoreCase(grant)) {
                    builder.authorizationGrantType(
                            AuthorizationGrantType.CLIENT_CREDENTIALS);
                }
            }
        }

        /*
         * Temporary fallback so the RegisteredClient is never created
         * without a supported grant type.
         */
        if (grantTypes == null ||
                (!grantTypes.contains("authorization_code")
                && !grantTypes.contains("refresh_token")
                && !grantTypes.contains("client_credentials"))) {

            builder.authorizationGrantType(
                    AuthorizationGrantType.CLIENT_CREDENTIALS);
        }

        if (redirectUri != null && !redirectUri.isBlank()) {
            builder.redirectUri(redirectUri);
        }

        if (accessTokenValidity != null || refreshTokenValidity != null) {

            TokenSettings.Builder tokenSettings = TokenSettings.builder();

            if (accessTokenValidity != null) {
                tokenSettings.accessTokenTimeToLive(
                        java.time.Duration.ofSeconds(accessTokenValidity));
            }

            if (refreshTokenValidity != null) {
                tokenSettings.refreshTokenTimeToLive(
                        java.time.Duration.ofSeconds(refreshTokenValidity));
            }

            builder.tokenSettings(tokenSettings.build());
        }

        return builder.build();
    });
}





import org.springframework.security.oauth2.core.AuthorizationGrantType;
import org.springframework.security.oauth2.core.ClientAuthenticationMethod;




