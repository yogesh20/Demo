import android.widget.Filter;
import android.widget.Filterable;
import java.util.ArrayList;

public class BankAdapter extends RecyclerView.Adapter<BankAdapter.BankViewHolder> implements Filterable {

    private List<BankModel> bankList;
    private List<BankModel> bankListFull;  // For filtering

    public BankAdapter(List<BankModel> bankList) {
        this.bankList = bankList;
        this.bankListFull = new ArrayList<>(bankList);
    }

    @NonNull
    @Override
    public BankViewHolder onCreateViewHolder(@NonNull ViewGroup parent, int viewType) {
        View view = LayoutInflater.from(parent.getContext()).inflate(R.layout.item_bank, parent, false);
        return new BankViewHolder(view);
    }

    @Override
    public void onBindViewHolder(@NonNull BankViewHolder holder, int position) {
        BankModel bank = bankList.get(position);
        holder.tvBankName.setText(bank.getName());
        holder.imgBankIcon.setImageResource(bank.getIconResId());
    }

    @Override
    public int getItemCount() {
        return bankList.size();
    }

    @Override
    public Filter getFilter() {
        return bankFilter;
    }

    private final Filter bankFilter = new Filter() {
        @Override
        protected FilterResults performFiltering(CharSequence constraint) {
            List<BankModel> filteredList = new ArrayList<>();
            if (constraint == null || constraint.length() == 0) {
                filteredList.addAll(bankListFull);
            } else {
                String filterPattern = constraint.toString().toLowerCase().trim();
                for (BankModel item : bankListFull) {
                    if (item.getName().toLowerCase().contains(filterPattern)) {
                        filteredList.add(item);
                    }
                }
            }
            FilterResults results = new FilterResults();
            results.values = filteredList;
            return results;
        }

        @Override
        protected void publishResults(CharSequence constraint, FilterResults results) {
            bankList.clear();
            bankList.addAll((List) results.values);
            notifyDataSetChanged();
        }
    };

    static class BankViewHolder extends RecyclerView.ViewHolder {
        TextView tvBankName;
        ImageView imgBankIcon;

        public BankViewHolder(@NonNull View itemView) {
            super(itemView);
            tvBankName = itemView.findViewById(R.id.tvBankName);
            imgBankIcon = itemView.findViewById(R.id.imgBankIcon);
        }
    }
}
