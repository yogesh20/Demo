<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:layout_gravity="center"
    android:minWidth="280dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Block User"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="16dp" />

    <!-- User Icon -->
    <TextView
        android:id="@+id/tvInitials"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:gravity="center"
        android:text="MS"
        android:textSize="20sp"
        android:textColor="@android:color/white"
        android:background="@drawable/bg_circle"
        android:layout_marginBottom="12dp" />

    <!-- User Name -->
    <TextView
        android:id="@+id/tvUserName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MAHESH  S"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="8dp" />

    <!-- Description -->
    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This user cannot request\nor send money to you after\nblocking"
        android:textSize="14sp"
        android:textColor="#777777"
        android:textAlignment="center"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- Button Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="2">

        <TextView
            android:id="@+id/btnGoBack"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Go Back"
            android:textColor="#7A00E6"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="12dp" />

        <TextView
            android:id="@+id/btnConfirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Confirm"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_confirm_button"
            android:gravity="center"
            android:textStyle="bold"
            android:padding="12dp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>
