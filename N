return context -> {

    if (!"access_token".equals(context.getTokenType().getValue())) {
        return;
    }

    String clientId = context.getRegisteredClient().getClientId();

    String authorities = jdbcTemplate.queryForObject(
        """
        SELECT authorities
        FROM oauth_client_details
        WHERE client_id = ?
        """,
        String.class,
        clientId
    );
