    private fun getAmountFromString(): String? {
        transactionAmount = textSpeechString!!.substring(textSpeechString!!.lastIndexOf("Rs.") + 3)
        val iend = transactionAmount!!.indexOf(" ") //this finds the first occurrence of "."
        if (iend != -1) {
            transactionAmount = transactionAmount!!.substring(0, iend) //this will give amount
        }
        return transactionAmount
    }

    private fun playSoundNew(transactionAmount: String?) {
        textToSpeech = TextToSpeech(applicationContext) { status ->
            try {
                if (status == TextToSpeech.SUCCESS) {
                    //User selected language for notification
                    val languageCode: String
                    languageCode = if (MyApplication.IS_SBIPAY_MERCHANT) {
                        SharedPreferenceHelper.getInstance().merVoiceNotificatonLanguageCode
                    } else {
                        SharedPreferenceHelper.getInstance().voiceNotificatonLanguageCode
                    }
                    val result: Int
                    result = if (languageCode.equals(AppConstants.CODE_HINDI, ignoreCase = true)) {
                        textToSpeech!!.setLanguage(Locale("hi", "IN"))
                    } else {
                        textToSpeech!!.setLanguage(Locale.ENGLISH)
                    }
                    var textToRead: String
                    textToRead = if (SharedPreferenceHelper.getInstance().merVoiceNotificatonLanguageCode == "hi" && MyApplication.IS_SBIPAY_MERCHANT || SharedPreferenceHelper.getInstance().voiceNotificatonLanguageCode == "hi" && !MyApplication.IS_SBIPAY_MERCHANT) {
                        "$hindiCreditTextOne $transactionAmount $hindiCreditTextTwo"
                    } else {
                        "$transactionAmount $englishCreditText"
                    }
                    if (result == TextToSpeech.LANG_MISSING_DATA
                            || result == TextToSpeech.LANG_NOT_SUPPORTED) {
                        textToSpeech!!.language = Locale.ENGLISH
                    }
                    LogUtil.info("jksdbjksdvbkjsdv_2", "true")

//                        textToSpeech.setPitch(1f);
//                        textToSpeech.setSpeechRate(1f);
                    if (android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.LOLLIPOP) {
                        textToSpeech!!.speak(textToRead, TextToSpeech.QUEUE_FLUSH, null,"2")
                    }

//                        textToSpeech.setPitch(1f);
//                        textToSpeech.setSpeechRate(1f);
                }
            } catch (e: Exception) {
            }
        }
    }

    companion object {
        private const val TAG = "BackupWorker"
    }
}
