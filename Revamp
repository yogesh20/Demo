import android.os.Parcel;
import android.os.Parcelable;

import androidx.annotation.NonNull;

import com.google.gson.annotations.SerializedName;

public class IOTTransactionHistory implements Parcelable {
    @SerializedName("trnRefNo")
    public String refNo;
    @SerializedName("trnDate")
    public String time;
    @SerializedName("txnType")
    public String transactionType;
    @SerializedName("txnNote")
    public String remarks;
    @SerializedName("txnStatus")
    public String status;
    @SerializedName("drCrFlag")
    public String transactionFlag;
    @SerializedName("txnStatusDesc")
    public String statusDesc;
    @SerializedName("txnAmount")
    public String amount;
    @SerializedName("custRefNo")
    public String customerRefNo;

    @SerializedName("payeeName")
    public String payeeName;
    @SerializedName("payeeVirtualAddress")
    public String payeeVpa;
    @SerializedName("payeeAccountNo")
    public String payeeAccountNumber;
    @SerializedName("payeeMaskAccountNo")
    public String payeeMaskAccountNo;
    @SerializedName("payeeBankCode")
    public String payeeBankCode;
    @SerializedName("payeeIfsc")
    public String payeeIfsc;

    @SerializedName("payerName")
    public String payerName;
    @SerializedName("payerVirtualAddress")
    public String payerVpa;
    @SerializedName("payerAccountNo")
    public String payerAccountNumber;
    @SerializedName("payerBankCode")
    public String payerBankCode;
    @SerializedName("payerIfsc")
    public String payerIfsc;

    public String addressType;
    @SerializedName("disputeStatus")
    public String disputeStatus;

    @SerializedName("payer_aadhaar_number")
    public String payer_aadhaar_number;

    @SerializedName("payType")
    public String payType;

    public String rrn;
    public String aeps_trans_ref_no;
    public String reason_desc;

    @SerializedName("txn_sub_type")
    public String txnSubType;
    @SerializedName("ref_url")
    public String refUrl;

    @SerializedName("disputeEnable")
    public String disputeEnable;

    @SerializedName("disputeStaus")
    public String disputeStaus;

    @SerializedName("back_office_enq_flag")
    public String backOfficeEnqFlag;
    @SerializedName("back_office_txn_date")
    public String backOfficeTxnDate;

    @SerializedName("txnId")
    public String txnId;
    @SerializedName("adjFlag")
    public String adjFlag;
    @SerializedName("adjCode")
    public String adjCode;

    @SerializedName("isLiteTxn")
    public boolean isLiteTxn;

    @SerializedName("payerAccountType")
    public String payerAccountType;

    @SerializedName("initiation_mode")
    public String initiationMode;

    @SerializedName("unauthflag")
    public String unauthflag;

    // ===== Parcelable implementation =====

    protected IOTTransactionHistory(Parcel in) {
        refNo = in.readString();
        time = in.readString();
        transactionType = in.readString();
        remarks = in.readString();
        status = in.readString();
        transactionFlag = in.readString();
        statusDesc = in.readString();
        amount = in.readString();
        customerRefNo = in.readString();
        payeeName = in.readString();
        payeeVpa = in.readString();
        payeeAccountNumber = in.readString();
        payeeMaskAccountNo = in.readString();
        payeeBankCode = in.readString();
        payeeIfsc = in.readString();
        payerName = in.readString();
        payerVpa = in.readString();
        payerAccountNumber = in.readString();
        payerBankCode = in.readString();
        payerIfsc = in.readString();
        addressType = in.readString();
        disputeStatus = in.readString();
        payer_aadhaar_number = in.readString();
        payType = in.readString();
        rrn = in.readString();
        aeps_trans_ref_no = in.readString();
        reason_desc = in.readString();
        txnSubType = in.readString();
        refUrl = in.readString();
        disputeEnable = in.readString();
        disputeStaus = in.readString();
        backOfficeEnqFlag = in.readString();
        backOfficeTxnDate = in.readString();
        txnId = in.readString();
        adjFlag = in.readString();
        adjCode = in.readString();
        isLiteTxn = in.readByte() != 0;
        payerAccountType = in.readString();
        initiationMode = in.readString();
        unauthflag = in.readString();
    }

    @Override
    public void writeToParcel(@NonNull Parcel dest, int flags) {
        dest.writeString(refNo);
        dest.writeString(time);
        dest.writeString(transactionType);
        dest.writeString(remarks);
        dest.writeString(status);
        dest.writeString(transactionFlag);
        dest.writeString(statusDesc);
        dest.writeString(amount);
        dest.writeString(customerRefNo);
        dest.writeString(payeeName);
        dest.writeString(payeeVpa);
        dest.writeString(payeeAccountNumber);
        dest.writeString(payeeMaskAccountNo);
        dest.writeString(payeeBankCode);
        dest.writeString(payeeIfsc);
        dest.writeString(payerName);
        dest.writeString(payerVpa);
        dest.writeString(payerAccountNumber);
        dest.writeString(payerBankCode);
        dest.writeString(payerIfsc);
        dest.writeString(addressType);
        dest.writeString(disputeStatus);
        dest.writeString(payer_aadhaar_number);
        dest.writeString(payType);
        dest.writeString(rrn);
        dest.writeString(aeps_trans_ref_no);
        dest.writeString(reason_desc);
        dest.writeString(txnSubType);
        dest.writeString(refUrl);
        dest.writeString(disputeEnable);
        dest.writeString(disputeStaus);
        dest.writeString(backOfficeEnqFlag);
        dest.writeString(backOfficeTxnDate);
        dest.writeString(txnId);
        dest.writeString(adjFlag);
        dest.writeString(adjCode);
        dest.writeByte((byte) (isLiteTxn ? 1 : 0));
        dest.writeString(payerAccountType);
        dest.writeString(initiationMode);
        dest.writeString(unauthflag);
    }

    @Override
    public int describeContents() {
        return 0;
    }

    public static final Creator<IOTTransactionHistory> CREATOR = new Creator<IOTTransactionHistory>() {
        @Override
        public IOTTransactionHistory createFromParcel(Parcel in) {
            return new IOTTransactionHistory(in);
        }

        @Override
        public IOTTransactionHistory[] newArray(int size) {
            return new IOTTransactionHistory[size];
        }
    };
}
