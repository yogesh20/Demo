import java.security.SecureRandom;

public static String generatePlayIntegrityNonce() {
    int length = 50;
    final String allowed = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";

    SecureRandom secureRandom = new SecureRandom(); // cryptographically strong PRNG

    StringBuilder nonce = new StringBuilder(length);

    for (int i = 0; i < length; i++) {
        int index = secureRandom.nextInt(allowed.length());
        nonce.append(allowed.charAt(index));
    }

    return nonce.toString();
}
