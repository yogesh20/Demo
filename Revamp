class TextToSpeechWorker(context: Context, workerParams: WorkerParameters) : Worker(context, workerParams) {
    private var textSpeechString: String? = null
    private var pipelineData: String? = null
    private var transactionType = 0
    private var textToSpeech: TextToSpeech? = null
    private var isReceiver = false
    var transactionAmount: String? = null

    //Security Enhancement added for text to speech , here below text made hardcore because text language is independent of voice language  so sound language can be different from app text language
    var englishCreditText = "Rupee received on BHIM SBI pay"
    var hindiCreditTextOne = "भीम एसबीआई पे पे "
    var hindiCreditTextTwo = "रुपये प्राप्त हुए"
    private val TTS_DEFAULT_PITCH = "tts_default_pitch"
    override fun doWork(): Result {
        //call methods to perform background task

        //get Input Data back using "inputData" variable
        textSpeechString = inputData.getString(AppConstants.TEXTTOSPEECHSTRING)
        transactionType = inputData.getInt(AppConstants.TRANSACTIONTYPE, 0)
        isReceiver = inputData.getBoolean(AppConstants.ISRECEIVER, false)
        pipelineData = inputData.getString(AppConstants.PIPELINEDATA)
        if (!textSpeechString!!.isEmpty() && (SharedPreferenceHelper.getInstance().isNotificationVoiceEnabled || SharedPreferenceHelper.getInstance().isMerNotificationVoiceEnabled)
                && (transactionType == AppConstants.UPI_TRANSACTION || transactionType == AppConstants.AEPS_TRANSACTION || transactionType == AppConstants.MERCHANT_CREDIT_NOTIFICATION) && isReceiver) {
            LogUtil.info("jksdbjksdvbkjsdv_0", "true")
            if (MyApplication.IS_SBIPAY_MERCHANT && pipelineData != null && !pipelineData!!.isEmpty()) {
                //for Merchant mode
                playSoundNew(newGetAmountFromString())
            } else if (textSpeechString != null && !textSpeechString!!.isEmpty()) {
                //for Customer mode
                playSoundNew(getAmountFromString())
            }
        } else {
            LogUtil.info("jksdbjksdvbkjsdv_1", "true")

            LogUtil.info(TAG, "false")
        }
        return Result.success()
    }

    private fun newGetAmountFromString(): String? {
        val data: String
        val arrOfStr: Array<String>
        var transactionAMount: String? = null
        try {
            if (!TextUtils.isEmpty(pipelineData)) {
                data = pipelineData!!.replace("|", ",")
                arrOfStr = data.split(",".toRegex(), 6).toTypedArray()
                transactionAMount = arrOfStr[3]
            }
        } catch (e: Exception) {
            LogUtil.printException(e)
        }
        return transactionAMount
    }//this will give amount

