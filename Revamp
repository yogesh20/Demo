<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Top 1/7 -->
    <item
        android:top="0dp"
        android:bottom="100dp">
        <shape android:shape="rectangle">
            <solid android:color="#EDEAFF"/>
        </shape>
    </item>

    <!-- Middle 5/7 -->
    <item
        android:top="100dp"
        android:bottom="600dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
        </shape>
    </item>

    <!-- Bottom 1/7 -->
    <item
        android:top="600dp">
        <shape android:shape="rectangle">
            <solid android:color="#EDEAFF"/>
        </shape>
    </item>

</layer-list>




<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:type="linear"
        android:angle="270"    <!-- top to bottom -->
        android:startColor="#EDEAFF"   <!-- top -->
        android:centerColor="#FFFFFF"  <!-- middle -->
        android:endColor="#EDEAFF"     <!-- bottom -->
        android:centerY="0.5" />       <!-- middle position -->
</shape>
