public class InitialsGenerator {

    public static String getInitials(String fullName) {
        if (fullName == null || fullName.trim().isEmpty()) {
            return "";
        }

        // Trim and split by spaces
        String[] parts = fullName.trim().split("\\s+");

        if (parts.length >= 2) {
            // Take first letter of first and last name
            return (parts[0].substring(0, 1) + parts[1].substring(0, 1)).toUpperCase();
        } else {
            // Only first name, return first 2 letters if possible
            String name = parts[0];
            if (name.length() >= 2) {
                return name.substring(0, 2).toUpperCase();
            } else {
                return name.toUpperCase(); // if name has only 1 letter
            }
        }
    }

    public static void main(String[] args) {
        System.out.println(getInitials("Ramdas Wani")); // Output: RW
        System.out.println(getInitials("Ramdas"));      // Output: RA
        System.out.println(getInitials("A"));           // Output: A
        System.out.println(getInitials("   Ram   "));   // Output: RA
    }
}
