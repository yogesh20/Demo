import android.os.Bundle;
import android.view.LayoutInflater;
import android.view.View;
import android.view.ViewGroup;

import com.google.android.material.bottomsheet.BottomSheetDialogFragment;
import com.google.android.material.tabs.TabLayout;

import android.widget.EditText;
import android.widget.RadioGroup;
import android.widget.Toast;

public class BankBottomSheet extends BottomSheetDialogFragment {

    @Override
    public View onCreateView(LayoutInflater inflater, ViewGroup container,
                             Bundle savedInstanceState) {
        View view = inflater.inflate(R.layout.bottom_sheet_bank_selection, container, false);

        EditText etSearch = view.findViewById(R.id.etSearch);
        TabLayout tabLayout = view.findViewById(R.id.tabLayout);
        RadioGroup popularBanks = view.findViewById(R.id.popularBanks);
        RadioGroup allBanks = view.findViewById(R.id.allBanks);

        popularBanks.setOnCheckedChangeListener((group, checkedId) -> {
            Toast.makeText(getContext(),
                    ((RadioButton) group.findViewById(checkedId)).getText().toString(),
                    Toast.LENGTH_SHORT).show();
        });

        allBanks.setOnCheckedChangeListener((group, checkedId) -> {
            Toast.makeText(getContext(),
                    ((RadioButton) group.findViewById(checkedId)).getText().toString(),
                    Toast.LENGTH_SHORT).show();
        });

        return view;
    }
}
