SELECT COUNT(*)
FROM VTUTTRNREQ TRN
INNER JOIN VTUTTRNREQPY PY
    ON TRN.TRNREFNO = PY.ORGTRNREFNO
WHERE TRN.PRACCNO = '00000035644518216'
  AND TRN.TRNDATE BETWEEN
      TO_DATE('10-05-24 00:00:00', 'DD-MM-RR HH24:MI:SS')
      AND TO_DATE('08-10-26 23:59:59', 'DD-MM-RR HH24:MI:SS')
  AND TRN.DRCRFLAG = 'D';
